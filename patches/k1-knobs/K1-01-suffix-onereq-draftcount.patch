+# K1 (Station sweep): the one-request normal draft count. serve.sh forwards these variables only when they are set
+# (K1-03 patch); unset = the shipped recipe (dynamic 5 or 7 drafts per normal step, 31 on copy runs).
+def _k1_int(name: str, lo: int, hi: int):
+    raw = os.environ.get(name, "").strip()
+    if not raw:
+        return None
+    val = int(raw)
+    if not lo <= val <= hi:
+        raise RuntimeError(f"suffix: {name}={raw} outside {lo}..{hi}")
+    return val
+
+
+K1_FIXED = _k1_int("DS41_K1_FIXED", 1, DSPARK_K)   # every one-request normal step verifies exactly this many drafts
+K1_LO = _k1_int("DS41_K1_LO", 1, DSPARK_K - 1)     # dynamic K's low arm (shipped: 5); the high arm stays DSPARK_K
+if K1_FIXED is not None and K1_LO is not None:
+    raise RuntimeError("suffix: set DS41_K1_FIXED or DS41_K1_LO, not both")
+if K1_LO is not None:
+    DYNK_LO = K1_LO
+    DYNK_PRIOR = (min(DYNK_PRIOR[0], 0.52 * DYNK_LO), DYNK_PRIOR[1], DYNK_PRIOR[2])  # prior mean <= the low arm
+DYNK_COST = os.environ.get("DS41_K1_COST", "").strip() or DYNK_COST   # step-time ratio hi : lo, or "auto"
 
