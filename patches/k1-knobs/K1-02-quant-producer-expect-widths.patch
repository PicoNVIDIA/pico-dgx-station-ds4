+def expect_widths():
+    """K1: the one-request fused widths this boot must capture. Unset = all of FUSED_WIDTHS (the shipped recipe).
+    DS41_QP_EXPECT_WIDTHS = "6,8" / "8" / "6" / "none" states another expectation. It can only name widths the CS16
+    seam library accepts (T 6 or 8: seam_quant_cs16.cu), and the capture must still match it exactly."""
+    raw = os.environ.get('DS41_QP_EXPECT_WIDTHS', '').strip()
+    if not raw:
+        return list(FUSED_WIDTHS)
+    if raw == 'none':
+        return []
+    want = sorted({int(x) for x in raw.split(',')})
+    if not set(want) <= set(FUSED_WIDTHS):
+        raise RuntimeError(f'quant_producer: DS41_QP_EXPECT_WIDTHS={raw} names a width outside {FUSED_WIDTHS}')
+    return want
+
