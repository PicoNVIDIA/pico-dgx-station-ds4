+        killed = True
+    n = _S.skip_steps // SKIP_TICK
+    rec = {"event": "stage_skip", "host_steps": _S.skip_steps, "copied": tot[0], "skipped": tot[1],
+           "audited": tot[2], "mismatch_words": tot[3], "copied_since": since[0], "skipped_since": since[1],
+           "swap_invalidations": _S.skip_swaps, "lanes": len(_S.skip_tags), "audit": _S.skip_cfg[2],
