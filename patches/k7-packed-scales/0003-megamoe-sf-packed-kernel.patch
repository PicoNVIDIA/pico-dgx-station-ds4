+def render(text: str, cfg: dict) -> str:
+    """The fork header's text with every edit applied. Raises unless each `before` occurs exactly once (so an edit
+    can neither be skipped nor land twice) and no placeholder is left."""
+    fill = {"@BIAS@": str(int(cfg["bias"])), "@TXB@": str(int(cfg["tx"])), "@CPFMT@": str(cfg["cpfmt"]),
+            "@BITS@": str(int(cfg["bits"]))}
+    for name, where, before, after in EDITS:
+        n = text.count(before)
+        if n != 1:
+            raise RuntimeError(f"megamoe K7: edit {name!r} (lines {where} of the fork header) matches {n} times, "
+                               f"expected 1: the fork header is not the one this edit list was written against")
+        for k, v in fill.items():
+            after = after.replace(k, v)
+        if "@" in after:
+            raise RuntimeError(f"megamoe K7: edit {name!r} carries an unknown placeholder")
+        text = text.replace(before, after)
+    return text
