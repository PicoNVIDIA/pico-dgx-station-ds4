+FILE = "include/deep_gemm/impls/sm100_fp8_fp4_mega_moe.cuh"
+MODES = {"a2b6": "b6", "a2b4": "b4", "kernel-b6": "b6", "kernel-b4": "b4"}
+# bias: packed value = code - bias. group: global bytes of 16 packed codes. cp: tcgen05.cp decompress qualifier.
+# (The same numbers as gracetier_rt/runtime/gracetier_sfpack.FORMATS; the unit test compares the two tables.)
+FORMATS = {"b4": {"bits": 4, "bias": 112, "group": 8, "cp": ".b8x16.b4x16_p64"},
+           "b6": {"bits": 6, "bias": 64, "group": 12, "cp": ".b8x16.b6x16_p32"}}
+CP_FORMS = ("decomp", "plain")
+
+
+def config(value: str, cp: str = "") -> dict:
+    """The variant for GRACETIER_SF_PACK=value and GRACETIER_SF_PACK_CP=cp ("" = decomp: the copy to tensor memory
+    carries the decompress qualifier; plain: the copy the fork has today, for the case that the 4- / 6-bit tensor
+    map already left one code per byte in shared memory)."""
+    if value not in MODES:
+        raise RuntimeError(f"megamoe K7: GRACETIER_SF_PACK={value!r} is not one of {sorted(MODES)}")
+    cp = cp or "decomp"
+    if cp not in CP_FORMS:
+        raise RuntimeError(f"megamoe K7: GRACETIER_SF_PACK_CP={cp!r} must be one of {CP_FORMS} or unset")
+    f = FORMATS[MODES[value]]
+    return {"fmt": MODES[value], "cp": cp, "tag": MODES[value] + cp[0], "bits": f["bits"], "bias": f["bias"],
+            "tx": 32 * f["group"], "cpfmt": f["cp"] if cp == "decomp" else ""}
