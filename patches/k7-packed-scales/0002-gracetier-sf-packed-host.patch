+def _sfp_audit_call(a, y, l1, l2, symm, args, kwargs) -> None:
+    """K7 audit, right after the MegaMoE call of an audit layer: three more runs of the same call on the same
+    SymmBuffer state -- K7 word 0 and the layer's dense banks (twice), then the word back and the packed banks -- and,
+    on the device, the count of 16-bit words in which the packed result differs from the dense one, and in which
+    the two dense results differ from each other (the control: the reference must repeat itself). The call's own y
+    is NOT compared: when the router asked for the combine in the seam (megamoe fork: C11 skip_combine, cleared by
+    the kernel at its end) the kernel does not write y at all; the three re-runs find the flag cleared and combine
+    themselves. The packed run is last, so the slots the seam reads and the K7 word are left as the call left
+    them. No host read; capturable."""
+    import torch
+
+    _, d1, d2, addr = a
+    st = _S.sfp_stat
+    y1, y2, y3 = torch.empty_like(y), torch.empty_like(y), torch.empty_like(y)
+    _S.sfp_word.zero_()
+    _S.sfp_orig(y2, (l1[0], d1), (l2[0], d2), symm, *args, **kwargs)
+    _S.sfp_word.zero_()             # (also: no MegaMoE launch has another MegaMoE as its predecessor on the stream)
+    _S.sfp_orig(y3, (l1[0], d1), (l2[0], d2), symm, *args, **kwargs)
+    _S.sfp_word.fill_(addr)
+    _S.sfp_orig(y1, l1, l2, symm, *args, **kwargs)
+    w1, w2, w3 = (t.contiguous().view(torch.int16) for t in (y1, y2, y3))
+    st[0:1].add_(1)
+    if y.shape[0] > 16:
+        st[1:2].add_(1)
+    st[2:3].add_(w1.numel())
+    st[3:4].add_((w1 != w2).sum())
+    st[4:5].add_((w2 != w3).sum())
+
+
