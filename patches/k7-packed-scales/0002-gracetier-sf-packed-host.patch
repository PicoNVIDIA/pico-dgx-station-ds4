+    if new_err or n <= 4 or n % SFP_LOG_TICKS == 0:
+        aud = "" if st is None else (f" audit calls {st[0]} (T > 16: {st[1]}) words {st[2]} mismatch_words {st[3]} "
+                                     f"control_words {st[4]}")
+        _log(f"K7 packed scales: steps {_S.sfp_steps} kernel_err {err}{aud}")
+    if new_err:
