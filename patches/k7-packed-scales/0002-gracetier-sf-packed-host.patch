+"""K7 (research/K7-packed-scales.md, research/K7-impl.md): MegaMoE e8m0 scale banks stored packed, 4 or 6 bits a code.
+
+A bank is what `module._transformed_l{1,2}_weights[1]` holds: int32 (G, n, q), MN-major (strides (n*q, 1, n)), so
+its storage order is [group][K word][row] with 4 e8m0 codes per int32 word (fastpath_a12_retire.py:31, 71-77;
+fastpath_gracetier.py sf_strides). Seen as bytes that is uint8 (G, q, 4n): one COLUMN per (group, K word), and every
+16 consecutive code bytes of a column are the 128-bit chunk the expert kernel copies to one tensor-memory lane.
+
+Packed form (variant a2: the kernel never rebuilds the dense byte, it reads `code - bias` and the activation scale
+codes carry `+ bias`): every 16 codes of a column become one GROUP of `group_bytes` bytes, in the same order, so a
+column is uint8 [4n * bits / 8] and a bank uint8 (G, q, 4n * bits / 8).
+
+  b4   4 bits a code, bias 112 (codes 112..127), 8 B a group. TMA type .b4x16_p64 / tcgen05.cp .b8x16.b4x16_p64.
+       NVIDIA's PTX manual (9.7.18.9.1.1, figure "Individual decompression from 4-bit to 8-bit", read 2026-11-19)
+       shows that copy placing the nibble in bits 5..2 of the byte, i.e. byte = nibble << 2. If the hardware does
+       that, b4 cannot be exact; it is kept because experiment E2 (the hardware) has the last word.
+  b6   6 bits a code, bias 64 (codes 64..127), 12 B a group. TMA type .b6x16_p32 / tcgen05.cp .b8x16.b6x16_p32;
+       the same manual shows the 6-bit value in bits 5..0 (zero-extended). This is the form the manual supports.
+
+Order inside a group ("lo" / "hi"): lo = the first code in the lowest bits (b4: code 2j in bits 0..3 of byte j; b6:
+codes 4j..4j+3 as one little-endian 24-bit word, code 4j in bits 0..5), which is what the manual's .b4x16_p64 figure
+draws (LSB first). hi = the first code in the highest bits (the unknown E2 settles; decided here, at pack time).
+
+Also here: the tensor-map arguments for a packed bank and their encoding through the driver, the SymmBuffer control
+word the kernel reads them through, the dense-shaped address range the host side of DeepGEMM is handed instead of a
+bank, and the phase 0 probe (GRACETIER_SF_PACK=probe). No vllm import; torch only.
+"""
+from __future__ import annotations
+
+import ctypes
+from dataclasses import dataclass
+from typing import Callable, Dict, Optional, Sequence, Tuple
+
+import torch
+
+HI = 0x70                       # the high nibble every b4-packable code has
+CHUNK_GROUPS = 32               # groups per pass of the checks (24 MiB of L1 scales)
+GiB = 1024 ** 3
+CODES = 16                      # codes per group = per 128-bit tensor-memory chunk
+TMAP_BYTES = 128                # sizeof(CUtensorMap)
+TMAP_BOX = (128, 4, 1)          # elements, groups-of-8 ("pieces"), columns: one 128-row block of one column
+# The SymmBuffer control word (megamoe fork: fold control block + 384 B, inside the 512-B tail of l2_empty_count that
+# the fork reserves; fastpath_megamoe.P3FOLD_CTL_OFFSET = 21009280, C11 at + 256).
+K7_OFFSET = 21009280 + 384
+K7_MAGIC = 0x374B5346
+K7_WORDS = 4                    # int32 [4] at K7_OFFSET + 8: magic, err (sticky, written by the kernel), 2 spare
+
+
+@dataclass(frozen=True)
+class Fmt:
+    name: str
+    bits: int
+    bias: int                   # packed value = code - bias; the activation scale codes carry + bias
+    group_bytes: int            # bytes of 16 packed codes in global memory
+    tma_type: str               # CUtensorMapDataType member
+    cp_fmt: str                 # tcgen05.cp qualifier of the decompressing copy
+
+    @property
+    def lo(self) -> int:
+        return self.bias
+
+    @property
+    def hi(self) -> int:
+        return self.bias + (1 << self.bits) - 1
+
+    @property
+    def act_max(self) -> int:
+        """The largest activation scale code that stays below the e8m0 NaN code after + bias."""
+        return 254 - self.bias
+
+
+FORMATS: Dict[str, Fmt] = {
+    "b4": Fmt("b4", 4, 112, 8, "CU_TENSOR_MAP_DATA_TYPE_16U4_ALIGN16B", ".b8x16.b4x16_p64"),
+    "b6": Fmt("b6", 6, 64, 12, "CU_TENSOR_MAP_DATA_TYPE_16U6_ALIGN16B", ".b8x16.b6x16_p32"),
+}
+ORDERS = ("lo", "hi")
+
+
+def fmt_of(fmt) -> Fmt:
+    if isinstance(fmt, Fmt):
+        return fmt
+    if fmt not in FORMATS:
+        raise ValueError(f"unknown packed scale format {fmt!r}; known {sorted(FORMATS)}")
+    return FORMATS[fmt]
+
+
+# ================================================================================================ the format (pure)
+def bank_bytes(bank: torch.Tensor) -> torch.Tensor:
+    """uint8 (G, q, 4n) view of an MN-major int32 (G, n, q) bank, in storage order. No copy (checked)."""
+    if bank.dtype != torch.int32 or bank.dim() != 3:
+        raise ValueError(f"scale bank is {tuple(bank.shape)} {bank.dtype}, expected int32 (G, n, q)")
+    g, n, q = bank.shape
+    if tuple(bank.stride()) != (n * q, 1, n):
+        raise ValueError(f"scale bank strides {tuple(bank.stride())} are not the MN-major ({n * q}, 1, {n})")
+    v = bank.transpose(1, 2)
+    if not v.is_contiguous():
+        raise ValueError("scale bank storage is not [group][K word][row] contiguous")
+    out = v.view(torch.uint8)
+    if out.data_ptr() != bank.data_ptr() or tuple(out.shape) != (g, q, 4 * n):
+        raise RuntimeError("scale bank byte view moved or has the wrong shape")
+    return out
+
+
+def col_bytes(sf: torch.Tensor) -> torch.Tensor:
+    """uint8 (g, q, 4n): the columns of an int32 (g, n, q) scale tensor of ANY strides, in bank storage order (a
+    view when the tensor is MN-major, else a copy)."""
+    if sf.dtype != torch.int32 or sf.dim() != 3:
+        raise ValueError(f"scale tensor is {tuple(sf.shape)} {sf.dtype}, expected int32 (g, n, q)")
+    return sf.transpose(1, 2).contiguous().view(torch.uint8)
+
+
+def packed_col_bytes(n: int, fmt) -> int:
+    """Bytes of one packed column of n rows (4 codes a row)."""
+    f = fmt_of(fmt)
+    if (4 * n) % CODES:
+        raise ValueError(f"{n} rows is not a whole number of 16-code groups")
+    return 4 * n // CODES * f.group_bytes
+
+
+def packed_bytes(G: int, n: int, q: int, fmt) -> int:
+    return int(G) * int(q) * packed_col_bytes(n, fmt)
+
+
+def outside(d: torch.Tensor, fmt) -> torch.Tensor:
+    """Bool mask of the code bytes that the format cannot hold."""
+    f = fmt_of(fmt)
+    return (d < f.lo) | (d > f.hi)
+
+
+def pack_codes(d: torch.Tensor, fmt, order: str = "lo") -> torch.Tensor:
+    """Dense code bytes uint8 [..., 16m] -> packed uint8 [..., m * group_bytes]. A code outside the format's range
+    is packed modulo 2^bits (it does not survive unpack; count them with `outside`)."""
+    f = fmt_of(fmt)
+    if order not in ORDERS:
+        raise ValueError(f"order {order!r} must be one of {ORDERS}")
+    if d.dtype != torch.uint8 or d.shape[-1] % CODES:
+        raise ValueError(f"pack_codes: {tuple(d.shape)} {d.dtype}, expected uint8 with a multiple of 16 codes")
+    mask = (1 << f.bits) - 1
+    v = (d - f.bias) & mask                             # uint8 arithmetic wraps: out-of-range codes stay in 0..mask
+    if f.bits == 4:
+        a, b = (v[..., 0::2], v[..., 1::2]) if order == "lo" else (v[..., 1::2], v[..., 0::2])
+        return a | (b << 4)
+    v0, v1, v2, v3 = (v[..., i::4] for i in range(4))
+    if order == "hi":
+        v0, v1, v2, v3 = v3, v2, v1, v0
+    out = torch.empty(d.shape[:-1] + (d.shape[-1] // 4 * 3,), dtype=torch.uint8, device=d.device)
+    b0, b1, b2 = (0, 1, 2) if order == "lo" else (2, 1, 0)
+    out[..., b0::3] = v0 | ((v1 & 3) << 6)
+    out[..., b1::3] = (v1 >> 2) | ((v2 & 15) << 4)
+    out[..., b2::3] = (v2 >> 4) | (v3 << 2)
+    return out
+
+
+def unpack_codes(p: torch.Tensor, fmt, order: str = "lo") -> torch.Tensor:
+    """Packed uint8 [..., m * group_bytes] -> dense code bytes uint8 [..., 16m] (value + bias)."""
+    f = fmt_of(fmt)
+    if order not in ORDERS:
+        raise ValueError(f"order {order!r} must be one of {ORDERS}")
+    if p.dtype != torch.uint8 or p.shape[-1] % f.group_bytes:
+        raise ValueError(f"unpack_codes: {tuple(p.shape)} {p.dtype}, expected uint8 groups of {f.group_bytes} B")
+    if f.bits == 4:
+        out = torch.empty(p.shape[:-1] + (p.shape[-1] * 2,), dtype=torch.uint8, device=p.device)
+        lo, hi = (0, 1) if order == "lo" else (1, 0)
+        out[..., lo::2] = (p & 15) + f.bias
+        out[..., hi::2] = (p >> 4) + f.bias
+        return out
+    b0, b1, b2 = (0, 1, 2) if order == "lo" else (2, 1, 0)
+    x0, x1, x2 = p[..., b0::3], p[..., b1::3], p[..., b2::3]
+    v = [x0 & 63, (x0 >> 6) | ((x1 & 15) << 2), (x1 >> 4) | ((x2 & 3) << 4), x2 >> 2]
+    if order == "hi":
+        v.reverse()
+    out = torch.empty(p.shape[:-1] + (p.shape[-1] // 3 * 4,), dtype=torch.uint8, device=p.device)
+    for i in range(4):
+        out[..., i::4] = v[i] + f.bias
+    return out
+
+
+def kernel_bytes(p: torch.Tensor, fmt, order: str = "lo", shift: Optional[int] = None) -> torch.Tensor:
+    """What the manual says tensor memory holds after the decompressing copy of packed groups written in the
+    manual's own order (LSB first): element i of a group -> byte i = element << shift (b4: 2, b6: 0). A model of the
+    documentation for the tests, not of the hardware."""
+    f = fmt_of(fmt)
+    s = (2 if f.bits == 4 else 0) if shift is None else int(shift)
+    return (unpack_codes(p, f, "lo") - f.bias) << s
+
+
+def bias_word(w: int, bias: int) -> Tuple[int, bool]:
+    """The kernel's k7_bias_word (megamoe_sfpack.py) in Python: the 4 activation scale codes of one uint32 word, each
+    + bias, and whether a code was above 254 - bias (then the sum reaches the e8m0 NaN code or carries)."""
+    act_max = 254 - bias
+    if not 0x80 <= act_max <= 0xFE:
+        raise ValueError(f"bias {bias}: the byte test needs 128 <= 254 - bias")
+    add = (0x7F - (act_max & 0x7F)) * 0x01010101
+    over = (((w & 0x7F7F7F7F) + add) & w & 0x80808080) != 0
+    return (w + bias * 0x01010101) & 0xFFFFFFFF, over
+
+
+# ================================================================================================ a packed bank
+class PackedBank:
+    """One layer's packed scale bank over `raw`, a contiguous uint8 [G * q * P] tensor (P = packed_col_bytes(n)):
+    the bytes the expert kernel reads. `cols` uint8 (G, q, P); `rows32` int32 [G, q * P / 4], one row per group (what
+    the residency manager exchanges and digests)."""
+
+    def __init__(self, raw: torch.Tensor, G: int, n: int, q: int, fmt, order: str = "lo"):
+        self.fmt = fmt_of(fmt)
+        if order not in ORDERS:
+            raise ValueError(f"order {order!r} must be one of {ORDERS}")
+        self.order, self.G, self.n, self.q = order, int(G), int(n), int(q)
+        self.P = packed_col_bytes(self.n, self.fmt)
+        nbytes = self.G * self.q * self.P
+        if raw.dtype != torch.uint8 or raw.dim() != 1 or raw.numel() != nbytes or not raw.is_contiguous():
+            raise ValueError(f"packed bank storage is {tuple(raw.shape)} {raw.dtype}, expected uint8 [{nbytes}]")
+        if (self.q * self.P) % 16 or raw.data_ptr() % 32 or self.P % 32:
+            raise ValueError(f"packed bank: a group of {self.q * self.P} B / a column of {self.P} B / the address "
+                             f"{raw.data_ptr():#x} is not aligned as the residency rows (16 B) and the tensor map "
+                             f"(32 B) need")
+        self.raw = raw
+        self.cols = raw.view(self.G, self.q, self.P)
+        self.rows32 = raw.view(torch.int32).view(self.G, self.q * self.P // 4)
+        if self.cols.data_ptr() != raw.data_ptr() or self.rows32.data_ptr() != raw.data_ptr():
+            raise RuntimeError("packed bank view moved")
+
+    @property
+    def nbytes(self) -> int:
+        return int(self.raw.numel())
+
+    @property
+    def dense_nbytes(self) -> int:
+        return self.G * self.n * self.q * 4
+
+    def write_dense(self, g0: int, cols: torch.Tensor) -> int:
+        """Pack dense columns uint8 (g, q, 4n) (any device) into groups g0.. ; returns the codes outside the
+        format's range (they must be 0 for the bank to be the checkpoint's scales)."""
+        g = int(cols.shape[0])
+        if cols.dtype != torch.uint8 or tuple(cols.shape[1:]) != (self.q, 4 * self.n) or g0 < 0 or g0 + g > self.G:
+            raise ValueError(f"write_dense: {tuple(cols.shape)} {cols.dtype} at group {g0} of {self.G}, expected "
+                             f"uint8 (g, {self.q}, {4 * self.n})")
+        bad = 0
+        for a in range(0, g, CHUNK_GROUPS):
+            d = cols[a:a + CHUNK_GROUPS]
+            bad += int(outside(d, self.fmt).sum())
+            self.cols[g0 + a:g0 + a + d.shape[0]].copy_(pack_codes(d, self.fmt, self.order))
+        return bad
+
+    def mismatch(self, g0: int, cols: torch.Tensor) -> int:
+        """Bytes of dense columns uint8 (g, q, 4n) (any device) that differ from this bank's groups g0.. unpacked."""
+        g = int(cols.shape[0])
+        bad = 0
+        for a in range(0, g, CHUNK_GROUPS):
+            d = cols[a:a + CHUNK_GROUPS].to(self.raw.device)
+            u = unpack_codes(self.cols[g0 + a:g0 + a + d.shape[0]], self.fmt, self.order)
+            bad += int((u != d).sum())
+        return bad
+
+    def dense(self, g0: int, g1: int) -> torch.Tensor:
+        """Groups g0..g1-1 unpacked: a new MN-major int32 (g1 - g0, n, q) tensor on the bank's device."""
+        u = unpack_codes(self.cols[g0:g1], self.fmt, self.order).contiguous()
+        return u.view(torch.int32).view(g1 - g0, self.q, self.n).transpose(1, 2)
+
+
+# ================================================================================================ the tensor map
+def tma_args(pk: PackedBank) -> dict:
+    """cuTensorMapEncodeTiled arguments of a packed bank as the expert kernel loads it: a 3-D tensor of sub-byte
+    elements, dim 0 = the 128 elements (8 groups) the PTX manual fixes as the box size of these types (64 B of
+    .b4x16_p64, 96 B of .b6x16_p32 on sm_100f: 9.7.10.28.5.1), dim 1 = those 8-group pieces down a column, dim 2 =
+    the columns (group * q + K word). One load of box (128, 4, 1) at (0, 4 * N block, column) brings one 128-row
+    block of one column: 32 groups, each padded to 16 B in shared memory, 512 B, the size of the dense block."""
+    f = pk.fmt
+    piece = 8 * f.group_bytes
+    if pk.P % piece or (pk.P // piece) % TMAP_BOX[1]:
+        raise ValueError(f"packed column of {pk.P} B is not a whole number of {TMAP_BOX[1] * piece}-B blocks")
+    a = {"dtype": f.tma_type, "rank": 3, "address": int(pk.raw.data_ptr()),
+         "dims": (TMAP_BOX[0], pk.P // piece, pk.G * pk.q), "strides": (piece, pk.P), "box": TMAP_BOX,
+         "elem_strides": (1, 1, 1), "interleave": "CU_TENSOR_MAP_INTERLEAVE_NONE",
+         "swizzle": "CU_TENSOR_MAP_SWIZZLE_NONE", "l2": "CU_TENSOR_MAP_L2_PROMOTION_L2_256B",
+         "oob": "CU_TENSOR_MAP_FLOAT_OOB_FILL_NONE"}
+    if a["address"] % 32 or any(s % 32 for s in a["strides"]):
+        raise ValueError(f"tensor map: address / strides {a['address']:#x} {a['strides']} must be 32-B aligned")
+    return a
+
+
+def tx_bytes(fmt) -> int:
+    """Global-memory bytes of one packed 128-row block (what the kernel tells its barrier to expect per CTA)."""
+    return TMAP_BOX[1] * 8 * fmt_of(fmt).group_bytes
+
+
+def _enum(mod, name: str) -> int:
+    for obj in vars(mod).values():
+        v = getattr(obj, name, None) if isinstance(obj, type) else None
+        if v is not None:
+            return int(v)
+    if hasattr(mod, name):
+        return int(getattr(mod, name))
+    near = sorted({k for o in vars(mod).values() if isinstance(o, type) for k in vars(o) if "TENSOR_MAP_DATA" in k})
+    raise RuntimeError(f"gracetier K7: the CUDA bindings have no {name}; tensor-map data types they know: {near}")
+
+
+def cuda_encode(args: dict) -> bytes:
+    """The 128 bytes of the tensor map, from the driver (libcuda.so.1 cuTensorMapEncodeTiled through ctypes, as
+    gracetier_vmm.CuDriver calls the VMM entry points; the enum VALUES are read by name from cuda.bindings.driver,
+    the bindings a12_retire's native_scales already imports). Box only."""
+    from cuda.bindings import driver as cu
+
+    lib = ctypes.CDLL("libcuda.so.1")
+    u32, u64 = ctypes.c_uint32, ctypes.c_uint64
+    fn = lib.cuTensorMapEncodeTiled
+    fn.restype = ctypes.c_int
+    fn.argtypes = [ctypes.c_void_p, ctypes.c_int, u32, ctypes.c_void_p, ctypes.POINTER(u64), ctypes.POINTER(u64),
+                   ctypes.POINTER(u32), ctypes.POINTER(u32), ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_int]
+    r = int(args["rank"])
+    buf = ctypes.create_string_buffer(TMAP_BYTES + 64)
+    base = ctypes.addressof(buf)
+    ptr = (base + 63) // 64 * 64
+    rc = fn(ctypes.c_void_p(ptr), _enum(cu, args["dtype"]), r, ctypes.c_void_p(args["address"]),
+            (u64 * r)(*args["dims"]), (u64 * (r - 1))(*args["strides"]), (u32 * r)(*args["box"]),
+            (u32 * r)(*args["elem_strides"]), _enum(cu, args["interleave"]), _enum(cu, args["swizzle"]),
+            _enum(cu, args["l2"]), _enum(cu, args["oob"]))
+    if rc != 0:
+        raise RuntimeError(f"gracetier K7: cuTensorMapEncodeTiled returned CUresult {rc} for {args}")
+    return ctypes.string_at(ptr, TMAP_BYTES)
+
+
+def encode_tma(args: dict, encoder: Optional[Callable[[dict], bytes]] = None) -> bytes:
+    out = (encoder or cuda_encode)(args)
+    if len(out) != TMAP_BYTES:
+        raise RuntimeError(f"gracetier K7: a tensor map of {len(out)} B (expected {TMAP_BYTES})")
+    return bytes(out)
+
+
+# ================================================================================================ the control word
+def k7_views(buffer: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """(desc int64 [1], ctl int32 [K7_WORDS]) views of a SymmBuffer's bytes. desc = the device address of the
+    calling layer's two tensor maps (L1 scales, L2 scales), 0 = the dense (stock) path; gt_stage's program (0, 0)
+    stores it before every MegaMoE of a packed layer. ctl[0] = K7_MAGIC once armed, ctl[1] = the kernel's sticky
+    error word (bit 0: an activation scale code above 254 - bias; bit 1: a packed call the kernel was not built for)."""
+    raw = buffer.view(torch.uint8)
+    if raw.dim() != 1 or raw.numel() < K7_OFFSET + 8 + 4 * K7_WORDS:
+        raise ValueError(f"SymmBuffer of {raw.numel()} B is smaller than the K7 control word's offset {K7_OFFSET}")
+    desc = raw[K7_OFFSET:K7_OFFSET + 8].view(torch.int64)
+    ctl = raw[K7_OFFSET + 8:K7_OFFSET + 8 + 4 * K7_WORDS].view(torch.int32)
+    if desc.data_ptr() != raw.data_ptr() + K7_OFFSET:
+        raise RuntimeError("K7 control word view moved")
+    return desc, ctl
+
+
+# ================================================================================================ the dense address
+def alias_ops(nbytes: int, gran: int) -> int:
+    """Granules of one aliased range of nbytes."""
+    return -(-int(nbytes) // int(gran))
+
+
+def dummy_dense(arena, GV, G: int, shapes: Sequence[Tuple[int, int]], dev, fill: int = 0xFF,
+                view: Optional[Callable] = None) -> tuple:
+    """The dense-shaped tensors DeepGEMM's host side is handed in place of the banks: per (n, q) in `shapes` one
+    MN-major int32 (G, n, q) tensor over a reserved address range whose every granule is mapped onto ONE physical
+    granule (arena.alloc once; gracetier_vmm.VmmArena.map maps one allocation at many addresses, as it does for the
+    shared weight scratch). The host builds its (unused) tensor map from the address and the shape; the K7 kernel
+    never loads through it. The granule holds `fill` (0xFF = the e8m0 NaN code), so a stray dense read poisons the
+    output instead of looking plausible. One pair serves every layer."""
+    view = view or GV.device_view
+    phys = arena.alloc(arena.gran, "k7.sf-dummy")
+    out = []
+    for i, (n, q) in enumerate(shapes):
+        nbytes = int(G) * int(n) * int(q) * 4
+        va = arena.reserve(nbytes)
+        for k in range(alias_ops(nbytes, arena.gran)):
+            arena.map(va + k * arena.gran, arena.gran, phys, 0)
+        if i == 0:
+            view(arena, va, arena.gran, torch.uint8, (arena.gran,), dev).fill_(fill)
+        span = alias_ops(nbytes, arena.gran) * arena.gran
+        t = view(arena, va, span, torch.int32, (int(G), int(q), int(n)), dev).transpose(1, 2)
+        if tuple(t.shape) != (G, n, q) or tuple(t.stride()) != (n * q, 1, n):
+            raise RuntimeError(f"K7 dummy bank is {tuple(t.shape)} / {tuple(t.stride())}, not MN-major ({G}, {n}, {q})")
+        out.append(t)
+    return tuple(out)
+
+
+# ================================================================================================ phase 0 probe
+def pack_bytes(u8: torch.Tensor) -> torch.Tensor:
+    """Dense code bytes uint8 [..., 2m] -> packed uint8 [..., m] (low nibbles; the b4 / lo form)."""
+    if u8.dtype != torch.uint8 or u8.shape[-1] % 2:
+        raise ValueError(f"pack_bytes: {tuple(u8.shape)} {u8.dtype}, expected uint8 with an even last dimension")
+    return (u8[..., 0::2] & 15) | ((u8[..., 1::2] & 15) << 4)
+
+
+def unpack_bytes(p: torch.Tensor) -> torch.Tensor:
+    """Packed uint8 [..., m] -> dense code bytes uint8 [..., 2m] (0x70 | nibble)."""
+    if p.dtype != torch.uint8:
+        raise ValueError(f"unpack_bytes: {p.dtype}, expected uint8")
+    out = torch.empty(p.shape[:-1] + (p.shape[-1] * 2,), dtype=torch.uint8, device=p.device)
+    out[..., 0::2] = (p & 15) | HI
+    out[..., 1::2] = (p >> 4) | HI
+    return out
+
+
+def pack_bank(bank: torch.Tensor) -> torch.Tensor:
+    """The whole bank packed (b4 / lo): uint8 (G, q, 2n), a new tensor on the bank's device."""
+    return pack_bytes(bank_bytes(bank))
+
+
+def new_stats() -> Dict[str, int]:
+    return {"banks": 0, "dense_bytes": 0, "packed_bytes": 0, "lo": 255, "hi": 0, "outside": 0, "mismatch": 0,
+            "mismatch_in_range": 0}
+
+
+def add_stats(tot: Dict[str, int], s: Dict[str, int]) -> Dict[str, int]:
+    for k in ("banks", "dense_bytes", "packed_bytes", "outside", "mismatch", "mismatch_in_range"):
+        tot[k] += s[k]
+    tot["lo"], tot["hi"] = min(tot["lo"], s["lo"]), max(tot["hi"], s["hi"])
+    return tot
+
+
+def probe_bank(bank: torch.Tensor, chunk_groups: int = CHUNK_GROUPS) -> Dict[str, int]:
+    """Pack the bank chunk by chunk (b4 / lo), unpack, compare every byte with the bank. Returns counters:
+    dense_bytes / packed_bytes; lo / hi = the smallest / largest code; outside = code bytes whose high nibble is not
+    7 (they cannot be packed); mismatch = bytes that differ after pack + unpack (must equal `outside`);
+    mismatch_in_range = mismatches among packable codes (must be 0: anything else is a bug in this file).
+    Reads the bank only; its temporaries are freed on return."""
+    v = bank_bytes(bank)
+    s = new_stats()
+    s["banks"] = 1
+    for g0 in range(0, v.shape[0], max(1, int(chunk_groups))):
+        d = v[g0:g0 + chunk_groups]
+        p = pack_bytes(d)
+        u = unpack_bytes(p)
+        bad = (d >> 4) != (HI >> 4)
+        diff = u != d
+        s["dense_bytes"] += d.numel()
+        s["packed_bytes"] += p.numel()
+        s["lo"] = min(s["lo"], int(d.min()))
+        s["hi"] = max(s["hi"], int(d.max()))
+        s["outside"] += int(bad.sum())
+        s["mismatch"] += int(diff.sum())
+        s["mismatch_in_range"] += int((diff & ~bad).sum())
+    return s
+
+
+def ok(s: Dict[str, int]) -> bool:
+    """The pack is lossless for everything probed."""
+    return s["banks"] > 0 and s["outside"] == 0 and s["mismatch"] == 0 and s["packed_bytes"] * 2 == s["dense_bytes"]
+
+
